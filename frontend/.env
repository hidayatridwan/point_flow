# Default untuk build lokal — nilai publik (PUBLIC_*), aman di-commit.
# Di CI/produksi, GitHub Actions override lewat environment variables
# (secrets PUBLIC_API_BASE_URL & PUBLIC_MIDTRANS_CLIENT_KEY).
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
PUBLIC_MIDTRANS_CLIENT_KEY=
PUBLIC_MIDTRANS_IS_PRODUCTION=false
