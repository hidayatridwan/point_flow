# Netlify production: set this in the Netlify UI to https://your-api-domain.com/api/v1
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Midtrans Snap (lihat docs/midtrans-integration.md): client key publik untuk
# memuat snap.js; IS_PRODUCTION=false memakai sandbox.
PUBLIC_MIDTRANS_CLIENT_KEY=
PUBLIC_MIDTRANS_IS_PRODUCTION=false
