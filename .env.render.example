# Point Flow — Deployment Worksheet untuk Render + Supabase
# ==========================================================
# Template nilai untuk deployment backend ke Render (Docker Hub) + Supabase (PostgreSQL).
#
# CARA PAKAI:
#   1. cp .env.render.example .env.render
#      (file dengan nama .env.render otomatis DIABAIKAN git — isi nilai asli di sana,
#      JANGAN pernah commit nilai asli ke repo)
#   2. Isi semua placeholder dari akun platform sesuai petunjuk per baris.
#   3. Salin nilai ke tempat tujuan sesuai dua section di bawah:
#      Section A -> GitHub Actions secrets
#      Section B -> Environment variables di dashboard Render

# ==========================================================
# A) GitHub Actions secrets
# Ditempatkan di: repo GitHub -> Settings -> Secrets and variables -> Actions
# -> New repository secret. Dipakai oleh .github/workflows/deploy-render.yml
# (workflow "Deploy to Render", trigger manual).
# ==========================================================

# Username akun/organisasi Docker Hub tempat repo image dibuat.
# Nilai ini JUGA menentukan nama image: docker.io/<DOCKERHUB_USERNAME>/point-flow:latest
# dan HARUS sama dengan Image URL yang diisi saat membuat service di Render (section C).
DOCKERHUB_USERNAME=<username-docker-hub>

# Personal Access Token Docker Hub (Account Settings -> Security -> Personal access
# tokens) dengan scope Read & Write. Dipakai untuk push image dari CI dan sebagai
# kredensial pull di Render (anti rate-limit; wajib bila repo image private).
DOCKERHUB_TOKEN=<access-token-docker-hub>

# Connection string Supabase untuk job migrasi — isi SAMA persis dengan DATABASE_URL (section B).
SUPABASE_DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# Deploy hook URL service Render. Ambil dari dashboard:
# Render -> service point-flow -> Settings -> Deploy Hook.
# Format: https://api.render.com/deploy/srv-xxxxxxxxx?key=yyyyyyyyy
RENDER_DEPLOY_HOOK=

# ==========================================================
# B) Environment variables service Render
# Ditempatkan di: dashboard Render -> service point-flow -> Environment
# -> Add environments.
# ==========================================================

# Jangan diubah: Render mengharuskan backend bind ke 0.0.0.0 dan
# mendengarkan pada port default web service Render (10000).
APP_HOST=0.0.0.0
APP_PORT=10000

# PostgreSQL Supabase via SESSION pooler (IPv4, mendukung prepared statements).
# Ambil dari: Dashboard Supabase -> tombol "Connect" -> pilih "Session pooler",
# salin string hasilnya di sini, lalu pastikan di akhiri ?sslmode=require.
# JANGAN pakai mode Transaction (port 6543): mode itu tidak mendukung prepared
# statements, sedangkan backend memakai sqlx yang memakai prepared statements.
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# Origin frontend yang diizinkan mengakses API. Isi URL site Netlify kamu:
#   https://<site-name>.netlify.app
# Bila nanti menambah domain custom: pisahkan dengan koma.
CORS_ALLOWED_ORIGINS=https://<site-name>.netlify.app

# Random string panjang, generate dari terminal dengan:
#   openssl rand -hex 32
JWT_SECRET=<hasil-openssl-rand-hex-32>

# Nilai di bawah mengikuti default production (lihat .env.prod.example):
JWT_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAME_SITE=None
REFRESH_TOKEN_COOKIE_DOMAIN=

# S3-compatible object storage untuk foto produk dan gambar QRIS (lihat
# docs/storefront-online-order.md Bagian 5.4). Isi manual dengan kredensial
# penyedia S3 production, lalu salin ke Environment variables di dashboard
# Render. Database hanya menyimpan object key; URL publik disusun dari
# S3_PUBLIC_URL + key.
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ==========================================================
# C) Nilai yang diisi di tempat LAIN (bukan env file)
# ==========================================================
# Render — buat service:
#   New -> Web Service -> Existing Image
#   Image URL             : docker.io/<DOCKERHUB_USERNAME>/point-flow:latest
#   Registry credential   : (tambahkan credential Docker Hub: username + token section A)
#   Region                : Singapore
#   Instance Type         : Free
#   Health Check Path     : /api/v1/health
#
# Netlify — Site configuration -> Environment variables:
#   PUBLIC_API_BASE_URL=https://<render-service-name>.onrender.com/api/v1
#
# Supabase:
#   Migrasi TIDAK perlu di-apply manual — job "migrate" di workflow Deploy to Render
#   yang menerapkan backend/migrations/*.sql secara otomatis (berurutan, dengan
#   tabel penjejak _point_flow_schema_migrations). Contoh data dashboard opsional
#   lewat input apply_seeds saat menjalankan workflow.
#
# Setelah deploy pertama sukses, buat akun admin pertama:
#   POST https://<render-service-name>.onrender.com/api/v1/auth/bootstrap-admin
#   (body & contoh lengkap ada di point_flow.postman_collection.json)
