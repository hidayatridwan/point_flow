APP_HOST=0.0.0.0
APP_PORT=8080

# Use this value when running the backend from the host with `cargo run`.
# The backend service in docker-compose.yml uses `postgres` as the database host.
DATABASE_URL=postgres://point_flow:point_flow@localhost:5432/point_flow
CORS_ALLOWED_ORIGINS=
JWT_SECRET=dev-only-change-this-secret-before-running-in-production
JWT_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=Lax
REFRESH_TOKEN_COOKIE_DOMAIN=

POSTGRES_DB=point_flow
POSTGRES_USER=point_flow
POSTGRES_PASSWORD=point_flow

# S3-compatible object storage untuk foto produk dan gambar QRIS (lihat
# docs/storefront-online-order.md Bagian 5.4). Pengembangan lokal memakai
# MinIO dari docker-compose.yml. Backend yang dijalankan dari host
# (`cargo run`) menjangkau MinIO via localhost:9000; service backend di
# compose menjangkaunya via http://minio:9000 (diatur di docker-compose.yml).
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=point-flow-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_PUBLIC_URL=http://localhost:9000/point-flow-dev
S3_FORCE_PATH_STYLE=true

# Midtrans Snap untuk pembayaran non-tunai (lihat docs/midtrans-integration.md).
# Backend menonaktifkan Midtrans bila MIDTRANS_SERVER_KEY kosong.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_BASE_URL=
MIDTRANS_NOTIFICATION_URL=
MIDTRANS_PAYMENT_EXPIRY_MINUTES=60
