APP_HOST=0.0.0.0
APP_PORT=8081

DATABASE_URL=postgres://pos:change-this-postgres-password@postgres:5432/pos
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAME_SITE=None
REFRESH_TOKEN_COOKIE_DOMAIN=

POSTGRES_DB=pos
POSTGRES_USER=pos
POSTGRES_PASSWORD=change-this-postgres-password

# Host directory for the PostgreSQL data dir (bind mount). Keep it OUTSIDE ~/app
# so deleting Docker volumes or re-syncing deploy artifacts never loses the DB.
POSTGRES_DATA_DIR=/srv/pos/postgres